{
  "protocol": "rae.repository-governance",
  "protocol_version": "1.0.0",
  "project": "ai-project-governance",
  "compatibility": {
    "min_coordinator_version": "1.0.0"
  },
  "governance": {
    "agent_instructions": "SECURITY.md",
    "entrypoints": [
      "README.md"
    ],
    "required": [
      "SECURITY.md",
      ".github/workflows/validate-rae-pr.yml"
    ],
    "rule_sets": [
      {
        "id": "public-runner-security",
        "path": "SECURITY.md",
        "priority": 100
      },
      {
        "id": "runner-operation",
        "path": "README.md",
        "priority": 90
      },
      {
        "id": "public-rae-postgres-runner",
        "path": ".github/workflows/validate-rae-pr.yml",
        "priority": 95
      }
    ]
  },
  "validation": {
    "provider": "github-actions",
    "mode": "independent-ci-repository",
    "workflow": ".github/workflows/validate-private-pr.yml",
    "source_repository": "Love-DC/colony-sim",
    "exact_head_sha_required": true
  },
  "conflicts": []
}
